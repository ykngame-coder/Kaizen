{
  "name": "supotsu",
  "version": "0.1.0",
  "private": true,
  "description": "SUPOTSU — plateforme Sport + Santé + Bien-être. Monorepo mobile-first.",
  "packageManager": "pnpm@10.33.0",
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "build": "turbo run build",
    "typecheck": "turbo run typecheck",
    "lint": "turbo run lint",
    "test": "turbo run test",
    "format": "prettier --write \"**/*.{ts,tsx,js,jsx,json,md}\"",
    "format:check": "prettier --check \"**/*.{ts,tsx,js,jsx,json,md}\"",
    "mobile": "pnpm --filter @supotsu/mobile start",
    "db:start": "npx --yes supabase start",
    "db:reset": "npx --yes supabase db reset",
    "db:types": "npx --yes supabase gen types typescript --local > packages/database/src/generated/database.types.ts"
  },
  "devDependencies": {
    "@typescript-eslint/eslint-plugin": "^8.18.0",
    "@typescript-eslint/parser": "^8.18.0",
    "eslint": "^8.57.1",
    "eslint-config-prettier": "^9.1.0",
    "prettier": "^3.4.2",
    "turbo": "^2.3.3",
    "typescript": "^5.7.2"
  }
}
