# React Native / Metro expect a flat node_modules. pnpm's default symlinked
# layout breaks many RN packages (css-interop, @babel/runtime resolution, etc.),
# so we use the hoisted linker for this monorepo.
node-linker=hoisted
# Keep Expo/RN peer resolution lenient.
strict-peer-dependencies=false
# Copy workspace packages into node_modules instead of symlinking them.
# Windows can't create the @supotsu/* symlinks without Developer Mode / admin
# (EISDIR on `symlink packages\shared -> ...`), so we inject real copies. This
# also matches what Metro expects for workspace resolution.
inject-workspace-packages=true
