{
  "expo": {
    "name": "Supotsu",
    "slug": "supotsu",
    "version": "0.1.0",
    "orientation": "portrait",
    "scheme": "supotsu",
    "userInterfaceStyle": "automatic",
    "newArchEnabled": true,
    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "com.supotsu.app"
    },
    "android": {
      "package": "com.supotsu.app"
    },
    "web": {
      "bundler": "metro",
      "output": "static"
    },
    "plugins": [
      "expo-router",
      "expo-secure-store",
      [
        "expo-camera",
        {
          "cameraPermission": "Supotsu utilise la caméra pour scanner les codes-barres des aliments."
        }
      ]
    ],
    "experiments": {
      "typedRoutes": false
    }
  }
}
